local function getRequestFunction()
    if typeof(request) == "function" then return request end
    if typeof(http_request) == "function" then return http_request end
    if syn and typeof(syn.request) == "function" then return syn.request end
    if http and typeof(http.request) == "function" then return http.request end
    return nil
end

local function lay_tong_slay()
    local stats = nguoi_choi:FindFirstChild("leaderstats")
    if stats then
        local slay = stats:FindFirstChild("Slays")
        if slay then return slay.Value end
    end
    return 0
end

local function ten_hien_thi()
    return nguoi_choi.DisplayName .. " (" .. nguoi_choi.Name .. ")"
end

local function formatTime(seconds)
    seconds = tonumber(seconds) or 0
    local h = math.floor(seconds / 3600)
    local m = math.floor((seconds % 3600) / 60)
    local s = math.floor(seconds % 60)
    return string.format("%02d:%02d:%02d", h, m, s)
end

local function getCurrentFarmTime()
    if thoi_diem_bat_dau > 0 then
        return os.time() - thoi_diem_bat_dau
    end
    return 0
end

local function createProgressEmbed(status)
    local tong_slay = lay_tong_slay()
    local slay_phien = tong_slay - slay_luc_bat_dau
    local thoi_gian = getCurrentFarmTime()

    local dang_hoat_dong = true
    local thoi_gian_khong_slay = os.time() - thoi_diem_slay_cuoi
    if thoi_gian_khong_slay >= 120 then
        dang_hoat_dong = false
    end

    if tong_slay > tong_slay_lan_truoc then
        thoi_diem_slay_cuoi = os.time()
        tong_slay_lan_truoc = tong_slay
    end

    local trang_thai, mau
    if status then
        trang_thai = status
        mau = 5763719
    elseif dang_hoat_dong then
        trang_thai = "✅ Bình thường"
        mau = 5763719
    else
        trang_thai = "❌ Clone đã out (2 phút không tăng slay)"
        mau = 15548997
    end

    return {
        ["title"] = "🦃 THEO DÕI STOMP",
        ["description"] =
            "**Account:** `" .. ten_hien_thi() .. "`\n\n" ..
            "⚔️ **Slay:** `" .. tostring(slay_phien) .. "`\n" ..
            "🏆 **Tổng slay:** `" .. tostring(tong_slay) .. "`\n\n" ..
            "📊 **Trạng thái:** `" .. trang_thai .. "`",
        ["color"] = mau,
        ["timestamp"] = DateTime.now():ToIsoDate(),
        ["footer"] = { ["text"] = "Turkey Monitor | " .. formatTime(thoi_gian) }
    }
end

local function createWebhookMessage(status)
    if webhook_url == "" then return false, "WebhookURL trống" end
    local requestFunc = getRequestFunction()
    if not requestFunc then return false, "Không tìm thấy request function" end

    local data = {
        ["username"] = "Turkey_Monitor🔔",
        ["embeds"] = { createProgressEmbed(status or "Đang chạy...") }
    }

    local encodeSuccess, body = pcall(function()
        return HttpService:JSONEncode(data)
    end)
    if not encodeSuccess then return false, tostring(body) end

    local url = webhook_url
    if string.find(url, "?") then
        url = url .. "&wait=true"
    else
        url = url .. "?wait=true"
    end

    local success, response = pcall(function()
        return requestFunc({
            Url = url,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = body
        })
    end)

    if not success then
        warn("Webhook create lỗi:", response)
        return false, tostring(response)
    end
    if not response then return false, "Không có response" end

    local statusCode = tonumber(response.StatusCode or response.Status)
    if statusCode and statusCode >= 400 then
        warn("Discord HTTP Error:", statusCode, response.Body or "")
        return false, tostring(statusCode)
    end

    local decodeSuccess, messageData = pcall(function()
        return HttpService:JSONDecode(response.Body)
    end)
    if not decodeSuccess then return false, "Không đọc được Discord response" end

    WebhookMessageID = messageData.id
    if not WebhookMessageID then return false, "Không lấy được Message ID" end

    return true
end

local function editWebhookMessage(status)
    if webhook_url == "" then return false end
    if not WebhookMessageID then return false end

    local requestFunc = getRequestFunction()
    if not requestFunc then return false end

    local data = {
        ["embeds"] = { createProgressEmbed(status) }
    }

    local encodeSuccess, body = pcall(function()
        return HttpService:JSONEncode(data)
    end)
    if not encodeSuccess then return false end

    local editURL = webhook_url .. "/messages/" .. tostring(WebhookMessageID)

    local success, response = pcall(function()
        return requestFunc({
            Url = editURL,
            Method = "PATCH",
            Headers = { ["Content-Type"] = "application/json" },
            Body = body
        })
    end)

    if not success then
        warn("Webhook edit lỗi:", response)
        return false
    end

    local statusCode = tonumber(response.StatusCode or response.Status)
    if statusCode and statusCode >= 400 then
        warn("Discord edit error:", statusCode, response.Body or "")
        return false
    end

    return true
end

local function bat_noclip_tuong()
    for _, vat_the in ipairs(Workspace:GetDescendants()) do
        if vat_the:IsA("BasePart") and vat_the.CanCollide then
            if not vat_the:IsDescendantOf(nguoi_choi.Character) then
                local ten = vat_the.Name:lower()
                if not (ten:find("floor") or ten:find("baseplate") or ten:find("spawn") or ten:find("ground")) then
                    local kich_thuoc = vat_the.Size
                    local la_san = (kich_thuoc.Y < kich_thuoc.X * 0.2) and (kich_thuoc.Y < kich_thuoc.Z * 0.2)
                    if not la_san then
                        tuong_da_tat[vat_the] = vat_the.CanCollide
                        vat_the.CanCollide = false
                    end
                end
            end
        end
    end
end

local function tat_noclip_tuong()
    for vat_the, trang_thai in pairs(tuong_da_tat) do
        if vat_the and vat_the.Parent then
            vat_the.CanCollide = trang_thai
        end
    end
    tuong_da_tat = {}
end

local function tim_muc_tieu()
    local nhan_vat = nguoi_choi.Character
    local goc = nhan_vat and nhan_vat:FindFirstChild("HumanoidRootPart")
    if not goc then return nil end
    local gan_nhat = nil
    local khoang_cach_min = math.huge
    for _, nguoi_khac in ipairs(Players:GetPlayers()) do
        if nguoi_khac ~= nguoi_choi then
            local char_khac = nguoi_khac.Character
            local goc_khac = char_khac and char_khac:FindFirstChild("HumanoidRootPart")
            local mau_khac = char_khac and char_khac:FindFirstChildOfClass("Humanoid")
            if goc_khac and mau_khac and mau_khac.Health > 0 and mau_khac.Health < 10 then
                local khoang_cach_toi_goc = (goc_khac.Position - toa_do_moi).Magnitude
                if khoang_cach_toi_goc <= ban_kinh_kich_hoat then
                    if khoang_cach_toi_goc < khoang_cach_min then
                        khoang_cach_min = khoang_cach_toi_goc
                        gan_nhat = nguoi_khac
                    end
                end
            end
        end
    end
    return gan_nhat
end

local function xu_ly_hien_tai()
    if not dang_chay then return end
    local nhan_vat = nguoi_choi.Character
    local goc = nhan_vat and nhan_vat:FindFirstChild("HumanoidRootPart")
    local humanoid = nhan_vat and nhan_vat:FindFirstChildOfClass("Humanoid")
    if not goc or not humanoid then return end
    local khoang_cach_toi_dich = (goc.Position - toa_do_moi).Magnitude
    if khoang_cach_toi_dich <= ban_kinh_kich_hoat then
        bat_noclip_tuong()
    else
        tat_noclip_tuong()
    end
    local muc_tieu_moi = tim_muc_tieu()
    if muc_tieu_moi then
        local char_muc_tieu = muc_tieu_moi.Character
        local goc_muc_tieu = char_muc_tieu and char_muc_tieu:FindFirstChild("HumanoidRootPart")
        if goc_muc_tieu then
            humanoid:MoveTo(goc_muc_tieu.Position)
            local khoang_cach = (goc_muc_tieu.Position - goc.Position).Magnitude
            if khoang_cach <= 5 then
                if remote_stomp and not dang_stomp then
                    dang_stomp = true
                    remote_stomp:FireServer()
                    task.wait(0.5)
                    dang_stomp = false
                end
            end
        end
        muc_tieu = muc_tieu_moi
    else
        muc_tieu = nil
        humanoid:MoveTo(goc.Position)
    end
end

local function xu_ly_hoi_sinh(nhan_vat)
    if not dang_chay then return end
    local goc = nhan_vat:WaitForChild("HumanoidRootPart", 5)
    if not goc then return end
    da_bay = false
    task.wait(0.5)
    local may_do = Workspace:FindFirstChild("MansionDetector", true)
    if may_do and may_do:IsA("BasePart") then
        for _, con in ipairs(may_do:GetChildren()) do
            if con:IsA("Weld") or con:IsA("WeldConstraint") or con:IsA("Motor6D") then
                con:Destroy()
            end
        end
        may_do.Anchored = true
        may_do.CFrame = goc.CFrame
    end
    task.wait(1.5)
    if not dang_chay then return end
    local goc_moi = nhan_vat:FindFirstChild("HumanoidRootPart")
    if goc_moi then
        local khoang_cach = (huong_moi.Position - goc_moi.Position).Magnitude
        local thoi_gian_bay = khoang_cach / 100
        local tween = TweenService:Create(goc_moi, TweenInfo.new(thoi_gian_bay, Enum.EasingStyle.Linear), {CFrame = huong_moi})
        tween:Play()
    end
end

local function bat_dau_bao_cao()
    if ket_noi_baocao then task.cancel(ket_noi_baocao); ket_noi_baocao = nil end

    slay_luc_bat_dau = lay_tong_slay()
    tong_slay_lan_truoc = slay_luc_bat_dau
    thoi_diem_slay_cuoi = os.time()
    thoi_diem_bat_dau = os.time()
    WebhookMessageID = nil

    ket_noi_baocao = task.spawn(function()
        while dang_chay do
            task.wait(1)
            if not dang_chay then break end
            if webhook_url == "" then continue end

            if not WebhookMessageID then
                local ok, err = createWebhookMessage("Đang chạy...")
                if not ok then warn("Tạo webhook thất bại:", err) end
            else
                pcall(function()
                    editWebhookMessage(nil)
                end)
            end
        end
    end)
end

local function bat_dau()
    dang_chay = true
    muc_tieu = nil
    if ket_noi_heartbeat then ket_noi_heartbeat:Disconnect() end
    ket_noi_heartbeat = RunService.Heartbeat:Connect(xu_ly_hien_tai)
    if ket_noi_hoisinh then ket_noi_hoisinh:Disconnect() end
    ket_noi_hoisinh = nguoi_choi.CharacterAdded:Connect(xu_ly_hoi_sinh)
    bat_dau_bao_cao()
end

local function dung()
    dang_chay = false
    if ket_noi_heartbeat then ket_noi_heartbeat:Disconnect(); ket_noi_heartbeat = nil end
    if ket_noi_hoisinh then ket_noi_hoisinh:Disconnect(); ket_noi_hoisinh = nil end
    if ket_noi_baocao then task.cancel(ket_noi_baocao); ket_noi_baocao = nil end
    tat_noclip_tuong()
    muc_tieu = nil
    if webhook_url ~= "" and WebhookMessageID then
        task.spawn(function()
            editWebhookMessage("🛑 Đã dừng")
        end)
    end
end

