-- HÀM BẬT NOCLIP TƯỜNG (KHÔNG XUYÊN SÀN)
local function bat_noclip_tuong()
    for _, vat_the in ipairs(Workspace:GetDescendants()) do
        if vat_the:IsA("BasePart") and vat_the.CanCollide then
            -- Bỏ qua nhân vật của người chơi
            if not vat_the:IsDescendantOf(nguoi_choi.Character) then
                -- Bỏ qua các part có tên chứa "Floor" hoặc "Baseplate" hoặc "Spawn"
                local ten = vat_the.Name:lower()
                if not (ten:find("floor") or ten:find("baseplate") or ten:find("spawn") or ten:find("ground")) then
                    -- Nếu part nằm ngang (mặt phẳng) thì bỏ qua (giữ va chạm)
                    -- Bằng cách kiểm tra kích thước: nếu chiều Y nhỏ hơn nhiều so với X và Z -> là sàn
                    local kich_thuoc = vat_the.Size
                    local la_san = (kich_thuoc.Y < kich_thuoc.X * 0.2) and (kich_thuoc.Y < kich_thuoc.Z * 0.2)
                    
                    if not la_san then
                        tuong_da_tat[vat_the] = vat_the.CanCollide
                        vat_the.CanCollide = false
                    end
                end
            end
        end
    end
end

-- HÀM TẮT NOCLIP TƯỜNG (KHÔI PHỤC)
local function tat_noclip_tuong()
    for vat_the, trang_thai in pairs(tuong_da_tat) do
        if vat_the and vat_the.Parent then
            vat_the.CanCollide = trang_thai
        end
    end
    tuong_da_tat = {}
end

local function luu_du_lieu_laser()
    du_lieu_goc_laser = {}
    for _, vat_the in ipairs(Workspace:GetDescendants()) do
        if vat_the:IsA("BasePart") and vat_the.Name:lower() == "laser" then
            du_lieu_goc_laser[vat_the] = {
                huong = vat_the.CFrame, hinh_dang = vat_the.Shape,
                kich_thuoc = vat_the.Size, chat_lieu = vat_the.Material,
                do_trong_suot = vat_the.Transparency
            }
            vat_the.Transparency = 1
            vat_the.CanCollide = false
        end
    end
end

local function dat_laser_tai_toa_do_moi()
    local so_luong = 0
    for _, vat_the in ipairs(Workspace:GetDescendants()) do
        if vat_the:IsA("BasePart") and vat_the.Name:lower() == "laser" then
            if not du_lieu_goc_laser[vat_the] then
                du_lieu_goc_laser[vat_the] = {
                    huong = vat_the.CFrame, hinh_dang = vat_the.Shape,
                    kich_thuoc = vat_the.Size, chat_lieu = vat_the.Material,
                    do_trong_suot = vat_the.Transparency
                }
            end
            vat_the.Shape = Enum.PartType.Block
            vat_the.Size = Vector3.new(20, 2, 20)
            vat_the.Material = Enum.Material.SmoothPlastic
            vat_the.Transparency = 1
            vat_the.CastShadow = false
            vat_the.CanCollide = true
            vat_the.Anchored = true
            vat_the.CFrame = huong_moi
            
            for _, hieu_ung in ipairs(vat_the:GetChildren()) do
                if hieu_ung:IsA("PointLight") or hieu_ung:IsA("SpotLight") or hieu_ung:IsA("SurfaceLight") or hieu_ung:IsA("ParticleEmitter") or hieu_ung:IsA("Beam") or hieu_ung:IsA("Trail") then
                    hieu_ung:Destroy()
                end
            end
            so_luong = so_luong + 1
        end
    end
    return so_luong
end

local function an_laser()
    for vat_the, du_lieu in pairs(du_lieu_goc_laser) do
        if vat_the and vat_the.Parent then
            vat_the.Transparency = 1
            vat_the.CanCollide = false
        end
    end
end

local function bat_dau_kich_hoat_laser()
    if kich_hoat_laser then return end
    kich_hoat_laser = true
    ket_noi_heartbeat = RunService.Heartbeat:Connect(function(thoi_gian_troi_qua)
        if not kich_hoat_laser then return end
        local nhan_vat = nguoi_choi.Character
        local goc_nhan_vat = nhan_vat and nhan_vat:FindFirstChild("HumanoidRootPart")
        if not goc_nhan_vat then return end
        
        bo_dem_kiem_tra = bo_dem_kiem_tra + thoi_gian_troi_qua
        if bo_dem_kiem_tra < 0.2 then return end
        bo_dem_kiem_tra = 0
        
        local khoang_cach = (goc_nhan_vat.Position - toa_do_moi).Magnitude
        
        -- Nếu đang ở trong khu vực tọa độ mới -> Bật noclip tường
        if khoang_cach <= ban_kinh_kich_hoat then
            bat_noclip_tuong() -- Bật noclip để bay xuyên tường
            if khoang_cach <= ban_kinh_tam then
                -- Đang đứng hẳn trong tâm
                thoi_gian_dung_tam = thoi_gian_dung_tam + 0.2
                if thoi_gian_dung_tam >= thoi_gian_cho and not laser_dang_hien then
                    laser_dang_hien = true
                    dat_laser_tai_toa_do_moi() -- Hiện laser
                    for vat_the, _ in pairs(du_lieu_goc_laser) do
                        if vat_the and vat_the.Parent then
                            vat_the.Transparency = 0
                        end
                    end
                end
            else
                thoi_gian_dung_tam = 0
            end
        else
            -- Ra khỏi khu vực -> Tắt noclip, ẩn laser
            tat_noclip_tuong()
            thoi_gian_dung_tam = 0
            if laser_dang_hien then
                laser_dang_hien = false
                an_laser()
            end
        end
    end)
end

local function xu_ly_hoi_sinh(nhan_vat)
    local goc_nhan_vat = nhan_vat:WaitForChild("HumanoidRootPart", 5)
    if not goc_nhan_vat then return end
    so_lan_hoi_sinh = so_lan_hoi_sinh + 1
    nhan_hoi_sinh.Text = "Số Lần Hồi Sinh: " .. so_lan_hoi_sinh
    
    task.wait(0.5)
    
    local may_do = Workspace:FindFirstChild("MansionDetector", true)
    if may_do and may_do:IsA("BasePart") then
        for _, con in ipairs(may_do:GetChildren()) do
            if con:IsA("Weld") or con:IsA("WeldConstraint") or con:IsA("Motor6D") then
                con:Destroy()
            end
        end
        may_do.Anchored = true
        may_do.CFrame = goc_nhan_vat.CFrame
    end
    
    luu_du_lieu_laser()
    
    task.wait(1.5)
    
    local goc_moi = nhan_vat:FindFirstChild("HumanoidRootPart")
    if goc_moi then
        local khoang_cach = (huong_moi.Position - goc_moi.Position).Magnitude
        local thoi_gian_bay = khoang_cach / 100
        
        local tween = TweenService:Create(
            goc_moi,
            TweenInfo.new(thoi_gian_bay, Enum.EasingStyle.Linear),
            {CFrame = huong_moi}
        )
        tween:Play()
    end
    
    bat_dau_kich_hoat_laser()
end

local function dung_tinh_nang_hoan_toan()
    kich_hoat_laser = false
    if ket_noi_heartbeat then ket_noi_heartbeat:Disconnect(); ket_noi_heartbeat = nil end
    if ket_noi_hoi_sinh then ket_noi_hoi_sinh:Disconnect(); ket_noi_hoi_sinh = nil end
    tat_noclip_tuong()
    giao_dien:Destroy()
end

local function tat_tinh_nang_tam_thoi()
    dang_bat = false
    nut_bat_tat.Text = "Bắt Đầu"
    nut_bat_tat.BackgroundColor3 = Color3.fromRGB(40, 140, 90)
    kich_hoat_laser = false
    laser_dang_hien = false
    thoi_gian_dung_tam = 0
    if ket_noi_hoi_sinh then ket_noi_hoi_sinh:Disconnect(); ket_noi_hoi_sinh = nil end
    if ket_noi_heartbeat then ket_noi_heartbeat:Disconnect(); ket_noi_heartbeat = nil end
    tat_noclip_tuong()
    an_laser()
end

local function bat_tinh_nang()
    dang_bat = true
    nut_bat_tat.Text = "Tắt"
    nut_bat_tat.BackgroundColor3 = Color3.fromRGB(180, 50, 60)
    
    kich_hoat_laser = false
    laser_dang_hien = false
    bo_dem_kiem_tra = 0
    thoi_gian_dung_tam = 0
    
    ket_noi_hoi_sinh = nguoi_choi.CharacterAdded:Connect(function(nhan_vat)
        if not dang_bat then return end
        xu_ly_hoi_sinh(nhan_vat)
    end)
end

